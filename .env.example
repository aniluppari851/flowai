# FlowSight AI Environment Configuration Template
# Copy this file to .env and configure your credentials

# Supabase PostgreSQL Configuration
# Obtain from your Supabase Dashboard: Project Settings -> API & Database
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Backend API Configuration
API_HOST=127.0.0.1
API_PORT=8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# n8n Automation Engine (Individual Workflow Webhooks)
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
# Workflow 1 (01_data_ingestion_pipeline.json): Data Ingestion & Quality Validation Pipeline
N8N_WEBHOOK_DATA_INGESTION=http://localhost:5678/webhook/data-ingestion-pipeline
NEXT_PUBLIC_N8N_WEBHOOK_DATA_INGESTION=http://localhost:5678/webhook/data-ingestion-pipeline
# Workflow 2 (02_traffic_intelligence_refresh.json): Real-time Traffic Intelligence & Forecast Refresh
N8N_WEBHOOK_TRAFFIC_INTELLIGENCE=http://localhost:5678/webhook/traffic-refresh-trigger
NEXT_PUBLIC_N8N_WEBHOOK_TRAFFIC_INTELLIGENCE=http://localhost:5678/webhook/traffic-refresh-trigger
# Workflow 3 (03_severe_incident_alert.json): Severe Incident, Anomaly & Spillback Alert Dispatch
N8N_WEBHOOK_INCIDENT_ALERT=http://localhost:5678/webhook/severe-incident-alert
NEXT_PUBLIC_N8N_WEBHOOK_INCIDENT_ALERT=http://localhost:5678/webhook/severe-incident-alert
# Workflow 4 (04_scheduled_daily_report.json): Scheduled Daily Mobility & Bottleneck Executive Report
N8N_WEBHOOK_DAILY_REPORT=http://localhost:5678/webhook/scheduled-daily-report
NEXT_PUBLIC_N8N_WEBHOOK_DAILY_REPORT=http://localhost:5678/webhook/scheduled-daily-report
# Workflow 5 (05_whatsapp_chatbot.json): WhatsApp Cloud AI Traffic Chatbot & Copilot
N8N_WEBHOOK_WHATSAPP_BOT=http://localhost:5678/webhook/whatsapp-webhook
NEXT_PUBLIC_N8N_WEBHOOK_WHATSAPP_BOT=http://localhost:5678/webhook/whatsapp-webhook

# Model Registry
MODEL_REGISTRY_MODE=PRODUCTION
DEBUG=False
